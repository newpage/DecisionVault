APP_NAME=DecisionVault
APP_ENV=development
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_MINUTES=60
DATABASE_URL=postgresql+psycopg://decisionvault:decisionvault@db:5432/decisionvault
CORS_ORIGINS=http://localhost:3000
STORAGE_PATH=/data/storage
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_ENABLED=true
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
DEMO_TENANT_SLUG=acme
DEMO_EMAIL=demo@decisionvault.ai
DEMO_PASSWORD=DecisionVault!
DV_SEED_DEMO_DATA=false
